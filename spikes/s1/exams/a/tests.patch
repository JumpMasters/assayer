+
+
+def test_round_micro_rejects_negative_with_typed_error() -> None:
+    # Imported inside the test on purpose: if the implementation is absent this must
+    # be a clean assertion failure, not a collection error. A collection error would
+    # be recorded as ERROR and dropped from the pass-rate denominator, which would
+    # silently inflate the measured pass rate.
+    from tollgate.domain.errors import InvalidAmount
+
+    assert issubclass(InvalidAmount, ValueError)
+    with pytest.raises(InvalidAmount):
+        round_micro(Decimal("-1"))
+    with pytest.raises(ValueError):
+        round_micro(Decimal("-1"))
